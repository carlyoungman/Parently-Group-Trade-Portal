<section class="bdm-policy-library color-{{ section.settings.color_scheme }}">
  <div class="bdm-policy-library__inner">
    {% if section.settings.heading != blank or section.settings.introduction != blank %}
      <div class="bdm-policy-library__header">
        {% if section.settings.heading != blank %}
          <h2 class="bdm-policy-library__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.introduction != blank %}
          <div class="bdm-policy-library__intro">
            {{ section.settings.introduction }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="bdm-policy-library__list">
        {% for block in section.blocks limit: 50 %}
          {% liquid
            assign policy_title = block.settings.policy_title | default: 'Policy document'
          %}

          <article class="bdm-policy-library__item" {{ block.shopify_attributes }}>
            <div class="bdm-policy-library__icon" aria-hidden="true">
              <span>PDF</span>
            </div>

            <div class="bdm-policy-library__content">
              {% if block.settings.category != blank %}
                <p class="bdm-policy-library__category">{{ block.settings.category | escape }}</p>
              {% endif %}

              <h3 class="bdm-policy-library__title">{{ policy_title | escape }}</h3>

              {% if block.settings.description != blank %}
                <div class="bdm-policy-library__description">
                  {{ block.settings.description | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>

            <div class="bdm-policy-library__action">
              {% if block.settings.docx_url != blank %}
                <a class="bdm-policy-library__button bdm-policy-library__button--secondary" href="{{ block.settings.docx_url }}" target="_blank" rel="noopener">
                  Download DOCX
                </a>
              {% else %}
                <span class="bdm-policy-library__button bdm-policy-library__button--secondary bdm-policy-library__button--disabled" aria-disabled="true">
                  Download DOCX
                </span>
              {% endif %}

              {% if block.settings.file_url != blank %}
                <a class="bdm-policy-library__button" href="{{ block.settings.file_url }}" target="_blank" rel="noopener">
                  View / Download PDF
                </a>
              {% else %}
                <span class="bdm-policy-library__button bdm-policy-library__button--disabled" aria-disabled="true">
                  View / Download PDF
                </span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="bdm-policy-library__empty">No policies available yet.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bdm-policy-library {
    --bdm-policy-background: rgb(var(--color-background, 255, 255, 255));
    --bdm-policy-text: rgb(var(--color-foreground, 31, 41, 51));
    --bdm-policy-muted: rgba(var(--color-foreground, 31, 41, 51), 0.68);
    --bdm-policy-border: rgba(var(--color-foreground, 31, 41, 51), 0.14);
    --bdm-policy-border-strong: rgba(var(--color-foreground, 31, 41, 51), 0.26);
    --bdm-policy-surface: rgb(var(--color-background, 255, 255, 255));
    --bdm-policy-surface-soft: rgba(var(--color-foreground, 31, 41, 51), 0.04);
    --bdm-policy-button: #75ad73;
    --bdm-policy-button-rgb: 117, 173, 115;
    --bdm-policy-button-text: #ffffff;
    --bdm-policy-focus: rgba(117, 173, 115, 0.3);
    background: var(--bdm-policy-background);
    color: var(--bdm-policy-text);
    font-family: var(--font-body-family, inherit);
    padding: 32px 22px 44px;
  }

  .bdm-policy-library__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .bdm-policy-library__header {
    max-width: 820px;
    margin-bottom: 18px;
  }

  .bdm-policy-library__heading {
    margin: 0;
    color: var(--bdm-policy-text);
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.09rem, 2.9vw, 2.88rem);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .bdm-policy-library__intro {
    margin-top: 10px;
    color: var(--bdm-policy-muted);
    font-size: 1.42rem;
    line-height: 1.5;
  }

  .bdm-policy-library__intro p {
    margin: 0;
  }

  .bdm-policy-library__list {
    display: grid;
    gap: 12px;
  }

  .bdm-policy-library__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    border: 1px solid var(--bdm-policy-border);
    border-radius: var(--media-radius, 8px);
    background: var(--bdm-policy-surface);
    padding: 16px;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .bdm-policy-library__item:hover {
    border-color: var(--bdm-policy-border-strong);
    box-shadow: 0 6px 16px rgba(var(--color-foreground, 31, 41, 51), 0.08);
    transform: translateY(-1px);
  }

  .bdm-policy-library__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border: 1px solid var(--bdm-policy-border);
    border-radius: var(--media-radius, 8px);
    background: var(--bdm-policy-surface-soft);
    color: var(--bdm-policy-button);
    flex: 0 0 auto;
  }

  .bdm-policy-library__icon span {
    font-size: 1.14rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .bdm-policy-library__content {
    min-width: 0;
  }

  .bdm-policy-library__category {
    color: var(--bdm-policy-button);
    font-size: 1.14rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin: 0 0 4px;
    text-transform: uppercase;
  }

  .bdm-policy-library__title {
    color: var(--bdm-policy-text);
    font-family: var(--font-heading-family, inherit);
    font-size: 1.54rem;
    line-height: 1.3;
    margin: 0;
  }

  .bdm-policy-library__description {
    color: var(--bdm-policy-muted);
    font-size: 1.26rem;
    line-height: 1.45;
    margin-top: 6px;
  }

  .bdm-policy-library__action {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }

  .bdm-policy-library__button {
    align-items: center;
    border: 1px solid var(--bdm-policy-button);
    border-radius: var(--buttons-radius, 6px);
    background: var(--bdm-policy-button);
    color: var(--bdm-policy-button-text);
    display: inline-flex;
    font-size: 1.3rem;
    font-weight: 800;
    justify-content: center;
    line-height: 1.2;
    min-height: 53px;
    min-width: 170px;
    padding: 10px 16px;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .bdm-policy-library__button:hover {
    background: #ffffff;
    color: var(--bdm-policy-button);
    filter: none;
  }

  .bdm-policy-library__button--secondary {
    background: var(--bdm-policy-button);
    color: var(--bdm-policy-button-text);
  }

  .bdm-policy-library__button--secondary:hover {
    background: #ffffff;
    color: var(--bdm-policy-button);
    filter: none;
  }

  .bdm-policy-library__button:focus-visible {
    outline: 3px solid var(--bdm-policy-focus);
    outline-offset: 3px;
  }

  .bdm-policy-library__button--disabled {
    border-color: var(--bdm-policy-border);
    background: var(--bdm-policy-surface-soft);
    color: var(--bdm-policy-muted);
    cursor: not-allowed;
  }

  .bdm-policy-library__empty {
    border: 1px dashed var(--bdm-policy-border-strong);
    border-radius: var(--media-radius, 8px);
    color: var(--bdm-policy-muted);
    margin: 0;
    padding: 22px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .bdm-policy-library {
      padding: 26px 14px 34px;
    }

    .bdm-policy-library__item {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 12px;
      padding: 14px;
    }

    .bdm-policy-library__action {
      grid-column: 1 / -1;
      flex-direction: column;
      justify-content: stretch;
    }

    .bdm-policy-library__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "tag": "section",
  "class": "section-policy-library",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Policies"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>View and download the latest policy documents.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Policy document",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Policy"
        },
        {
          "type": "text",
          "id": "policy_title",
          "label": "Policy title",
          "default": "Policy document"
        },
        {
          "type": "url",
          "id": "file_url",
          "label": "PDF file URL",
          "info": "Paste the public Bunny CDN PDF URL. The View / Download PDF button opens this file in a new tab, where customers can view it and use the browser download option."
        },
        {
          "type": "url",
          "id": "docx_url",
          "label": "DOCX file URL",
          "info": "Paste the public Bunny CDN DOCX URL. The Download DOCX button opens the file in a new tab or downloads it, depending on the browser."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Optional description"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Policy"
    }
  ]
}
{% endschema %}
