                    {%- assign tile_subtitle = fields[1] -%}
                    {%- assign tile_category = fields[2] -%}
                    {%- assign tile_type = fields[3] -%}
                    {%- assign tile_brand = fields[4] -%}
                    {%- assign tile_icon = fields[5] -%}
                    {%- assign tile_thumb = fields[6] -%}
                    {%- assign tile_link = fields[7] | strip -%}
