<style>
:root {
  --mh-putty: #f5f5f0;
  --mh-black: #0e0e0e;
  --mh-eco: #73ae70;
  --mh-eco-dark: #4d8a4a;
  --mh-blue: #24607a;
  --mh-blue-dark: #18506a;
  --mh-muted: #6b6b65;
  --mh-border: #d8d8d2;
  --mh-border-soft: rgba(14, 14, 14, 0.08);
  --mh-white: #ffffff;
  --mh-green-soft: #e8f3e7;
  --mh-blue-soft: #e8f0fb;
  --mh-shadow: 0 18px 42px rgba(14, 14, 14, 0.08);
  --mh-shadow-soft: 0 8px 24px rgba(14, 14, 14, 0.06);
  --mh-font: var(--font-body-family, 'Nunito Sans', sans-serif);
  --mh-radius: var(--media-radius, 10px);
}

.mh-wrap {
  background: var(--mh-white);
  color: var(--mh-black);
  font-family: var(--mh-font);
  font-size: 14px;
  line-height: 1.5;
  min-height: calc(100vh - 104px);
}

.mh-page-header {
  background:
    radial-gradient(circle at 82% 8%, rgba(115, 174, 112, 0.18), rgba(115, 174, 112, 0) 32%),
    linear-gradient(135deg, rgba(115, 174, 112, 0.11), rgba(115, 174, 112, 0) 38%),
    var(--mh-black);
  border-bottom: 3px solid var(--mh-eco);
  overflow: hidden;
  padding: 30px 28px 26px;
  position: relative;
}

.mh-page-header::before,
.mh-page-header::after {
  border: 1px solid rgba(115, 174, 112, 0.42);
  border-radius: 999px;
  content: '';
  pointer-events: none;
  position: absolute;
}

.mh-page-header::before {
  height: 170px;
  right: -42px;
  top: -96px;
  transform: rotate(-14deg);
  width: 280px;
}

.mh-page-header::after {
  border-color: rgba(255, 255, 255, 0.12);
  bottom: -84px;
  height: 170px;
  right: 16%;
  width: 170px;
}

.mh-page-header-inner {
  margin: 0 auto;
  max-width: var(--page-width, 1400px);
  position: relative;
  z-index: 1;
}

.mh-page-kicker {
  color: var(--mh-eco);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.mh-page-title {
  color: #ffffff;
  font-family: var(--font-heading-family, var(--mh-font));
  font-size: clamp(30px, 3vw, 42px);
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.05;
  margin: 0;
}

.mh-title-mark {
  display: inline;
}

.mh-page-sub {
  color: rgba(255, 255, 255, 0.64);
  font-size: 13px;
  line-height: 1.5;
  margin: 10px 0 0;
  max-width: 720px;
  padding-bottom: 0;
}

.mh-page-notes {
  display: none;
}

.mh-layout {
  background: var(--mh-white);
  display: grid;
  grid-template-columns: 258px minmax(0, 1fr);
  margin: 0;
  min-height: calc(100vh - 104px);
}

.mh-sidebar {
  background: var(--mh-white);
  border-right: 1px solid var(--mh-border);
  padding: 28px 18px;
}

.mh-filter-panel {
  background: var(--mh-white);
  border: 1px solid var(--mh-border);
  border-radius: var(--mh-radius);
  box-shadow: 0 1px 0 rgba(14, 14, 14, 0.03);
  padding: 18px;
  position: static;
}

.mh-filter-heading {
  color: var(--mh-black);
  font-family: var(--font-heading-family, var(--mh-font));
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.25;
  margin: 0 0 20px;
  padding-bottom: 16px;
  position: relative;
}

.mh-filter-heading::after {
  background: var(--mh-eco);
  border-radius: 999px;
  bottom: 0;
  content: '';
  height: 3px;
  left: 0;
  position: absolute;
  width: 44px;
}

.mh-sb-section {
  margin-bottom: 24px;
}

.mh-sb-section:last-child {
  margin-bottom: 0;
}

.mh-sb-label {
  border-bottom: 1px solid var(--mh-border);
  color: var(--mh-muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  margin-bottom: 12px;
  padding-bottom: 8px;
  text-transform: uppercase;
}

.mh-cb-row {
  align-items: center;
  background: transparent;
  border: 0;
  border-radius: 8px;
  color: var(--mh-black);
  cursor: pointer;
  display: flex;
  font-family: var(--mh-font);
  gap: 10px;
  margin: 0 0 2px;
  min-height: 0;
  padding: 7px 8px;
  text-align: left;
  transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  width: 100%;
}

.mh-cb-row:hover {
  background: rgba(115, 174, 112, 0.08);
  color: var(--mh-eco-dark);
}

.mh-cb-row:focus-visible,
.mh-tile:focus-visible,
.mh-active-filter-clear:focus-visible,
.mh-search-bar:focus-within {
  outline: 2px solid rgba(115, 174, 112, 0.32);
  outline-offset: 2px;
}

.mh-cb {
  align-items: center;
  border: 1.5px solid var(--mh-border);
  border-radius: 4px;
  display: flex;
  flex: 0 0 auto;
  height: 15px;
  justify-content: center;
  transition: background-color 180ms ease, border-color 180ms ease;
  width: 15px;
}

.mh-cb.is-checked {
  background: var(--mh-eco);
  border-color: var(--mh-eco);
}

.mh-cb.is-checked::after {
  border-bottom: 2px solid #ffffff;
  border-left: 2px solid #ffffff;
  content: '';
  display: block;
  height: 5px;
  transform: rotate(-45deg) translateY(-1px);
  width: 8px;
}

.mh-cb-label {
  color: var(--mh-black);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.3;
}

.mh-main {
  background: var(--mh-white);
  padding: 28px 28px 52px;
}

.mh-main-inner {
  max-width: var(--page-width, 1400px);
  min-width: 0;
}

.mh-toolbar {
  align-items: start;
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  grid-template-columns: minmax(0, 1fr);
  margin-bottom: 28px;
}

.mh-search-bar {
  align-items: center;
  background: var(--mh-white);
  border: 1.5px solid var(--mh-border);
  border-radius: var(--mh-radius);
  box-shadow: 0 1px 0 rgba(14, 14, 14, 0.03);
  color: var(--mh-muted);
  display: flex;
  flex: 1 1 340px;
  gap: 10px;
  min-height: 50px;
  padding: 0 16px;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.mh-search-bar:focus-within {
  border-color: var(--mh-eco);
  box-shadow: 0 0 0 4px rgba(115, 174, 112, 0.13);
}

.mh-search-bar input {
  background: transparent;
  border: 0;
  color: var(--mh-black);
  flex: 1;
  font-family: inherit;
  font-size: 13px;
  min-width: 0;
  outline: 0;
}

.mh-search-bar input::placeholder {
  color: #77756d;
}

.mh-active-filter {
  align-items: center;
  background: #eef8ed;
  border: 1px solid rgba(115, 174, 112, 0.35);
  border-radius: var(--mh-radius);
  color: var(--mh-eco-dark);
  display: flex;
  gap: 10px;
  padding: 12px 14px;
  width: 100%;
}

.mh-filter-icon {
  color: var(--mh-eco-dark);
  flex-shrink: 0;
  line-height: 1;
}

.mh-active-filter-text {
  flex: 1;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
}

.mh-active-filter-clear {
  background: transparent;
  border: 0;
  border-radius: 0;
  color: var(--mh-eco-dark);
  cursor: pointer;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  text-decoration: underline;
  transition: background-color 180ms ease, color 180ms ease;
  white-space: nowrap;
}

.mh-active-filter-clear:hover {
  color: var(--mh-black);
}

.mh-cat-group {
  margin-bottom: 36px;
}

.mh-cat-header {
  align-items: center;
  border-bottom: 1px solid var(--mh-border);
  display: flex;
  gap: 14px;
  justify-content: flex-start;
  margin-bottom: 16px;
  padding-bottom: 12px;
}

.mh-cat-title {
  color: var(--mh-black);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
}

.mh-cat-header::after {
  background: linear-gradient(90deg, var(--mh-eco), rgba(115, 174, 112, 0));
  border-radius: 999px;
  content: '';
  flex: 1;
  height: 2px;
  min-width: 44px;
}

.mh-tile-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.mh-tile {
  background: var(--mh-white);
  border: 1px solid var(--mh-border);
  border-radius: var(--mh-radius);
  color: var(--mh-black);
  cursor: default;
  display: flex;
  flex-direction: column;
  min-height: 170px;
  overflow: hidden;
  position: relative;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 140ms ease;
}

.mh-tile::before {
  background: var(--mh-eco);
  bottom: 0;
  content: '';
  left: 0;
  opacity: 0;
  position: absolute;
  top: 0;
  transition: opacity 160ms ease;
  width: 3px;
  z-index: 2;
}

.mh-tile[data-href] {
  cursor: pointer;
}

.mh-tile:hover {
  box-shadow: var(--mh-shadow);
  transform: translateY(-2px);
}

.mh-tile:hover::before {
  opacity: 1;
}

.mh-tile-mktg:hover {
  border-color: rgba(115, 174, 112, 0.9);
  box-shadow: 0 18px 42px rgba(115, 174, 112, 0.18);
}

.mh-tile-sustain::before {
  background: var(--mh-blue);
}

.mh-tile-sustain:hover {
  border-color: rgba(36, 96, 122, 0.78);
  box-shadow: 0 18px 42px rgba(36, 96, 122, 0.16);
}

.mh-tile-neutral::before {
  background: var(--mh-muted);
}

.mh-tile-neutral:hover {
  border-color: rgba(107, 107, 101, 0.52);
}

.mh-tile-thumb {
  align-items: center;
  background: var(--mh-green-soft);
  border-bottom: 0;
  display: flex;
  height: 112px;
  isolation: isolate;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  position: relative;
  transition: background-color 180ms ease, color 180ms ease;
}

.mh-tile-thumb::before {
  border: 1.5px solid currentColor;
  border-radius: 999px;
  content: '';
  height: 84px;
  left: 50%;
  opacity: 0.17;
  position: absolute;
  top: 50%;
  transition: opacity 180ms ease, transform 180ms ease;
  transform: translate(-50%, -50%) rotate(-8deg);
  width: 190px;
}

.mh-tile-thumb::after {
  border: 1.5px solid currentColor;
  border-radius: 999px;
  content: '';
  display: block;
  height: 68px;
  opacity: 0.12;
  position: absolute;
  right: -34px;
  top: 18px;
  transition: opacity 180ms ease, transform 180ms ease;
  transform: rotate(-18deg);
  width: 142px;
}

.mh-tile-thumb svg {
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.92);
  border-radius: 18px;
  box-shadow: 0 12px 24px rgba(14, 14, 14, 0.08);
  box-sizing: content-box;
  fill: none;
  height: 34px;
  margin-left: 0;
  padding: 13px;
  position: relative;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2;
  transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  width: 34px;
  z-index: 2;
}

.mh-thumb-mktg {
  background:
    radial-gradient(circle at 25% 28%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 28%),
    linear-gradient(135deg, var(--mh-green-soft), #f6fbf5);
  color: var(--mh-eco);
}

.mh-thumb-sustain {
  background:
    radial-gradient(circle at 25% 28%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 28%),
    linear-gradient(135deg, var(--mh-blue-soft), #f7f9fd);
  color: var(--mh-blue);
}

.mh-thumb-neutral {
  background:
    radial-gradient(circle at 25% 28%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 28%),
    linear-gradient(135deg, #eeeeea, #fafaf7);
  color: var(--mh-muted);
}

.mh-tile:hover .mh-tile-thumb svg {
  background: #ffffff;
  box-shadow: 0 14px 26px rgba(14, 14, 14, 0.12);
  transform: translateY(-2px) scale(1.04);
}

.mh-tile:hover .mh-tile-thumb::before {
  opacity: 0.24;
  transform: translate(-50%, -50%) rotate(-4deg) scale(1.04);
}

.mh-tile:hover .mh-tile-thumb::after {
  opacity: 0.18;
  transform: rotate(-14deg) scale(1.04);
}

.mh-tile-mktg:hover .mh-tile-thumb {
  background:
    radial-gradient(circle at 25% 28%, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 30%),
    linear-gradient(135deg, #dff1dd, #f4fbf2);
  color: var(--mh-eco-dark);
}

.mh-tile-sustain:hover .mh-tile-thumb {
  background:
    radial-gradient(circle at 25% 28%, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 30%),
    linear-gradient(135deg, #dfeaf8, #f5f9ff);
  color: var(--mh-blue-dark);
}

.mh-tile-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  padding: 15px 16px 16px;
}

.mh-tile-title {
  color: var(--mh-black);
  font-size: 13.5px;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 5px;
}

.mh-tile-sub {
  color: var(--mh-muted);
  font-size: 11.5px;
  line-height: 1.55;
}

.mh-tile[data-href] .mh-tile-body::after {
  color: var(--mh-eco-dark);
  content: 'View resource';
  display: block;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  margin-top: auto;
  padding-top: 14px;
}

.mh-tile-sustain[data-href] .mh-tile-body::after {
  color: var(--mh-blue-dark);
}

.mh-tile-neutral[data-href] .mh-tile-body::after {
  color: var(--mh-muted);
}

.mh-empty,
.mh-no-content {
  color: var(--mh-muted);
  font-size: 13px;
  padding: 24px 0;
}

.mh-empty p {
  margin: 0;
}

@media (max-width: 960px) {
  .mh-layout {
    grid-template-columns: 1fr;
    padding: 0;
  }

  .mh-sidebar {
    border-bottom: 1px solid var(--mh-border);
    border-right: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mh-main {
    padding: 24px 18px 40px;
  }

  .mh-tile-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .mh-page-header {
    padding: 24px 18px 24px;
  }

  .mh-page-title {
    font-size: 30px;
  }

  .mh-page-sub {
    font-size: 12px;
  }

  .mh-tile-grid {
    grid-template-columns: 1fr;
  }

  .mh-active-filter {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .mh-active-filter-clear {
    margin-left: 23px;
  }

  .mh-sidebar {
    grid-template-columns: 1fr;
  }
}
</style>

{%- unless request.design_mode -%}
  {%- if section.settings.require_login -%}
    {%- unless customer -%}
      {%- assign return_url = request.path | url_encode -%}
      <script>window.location = "/account/login?checkout_url={{ return_url }}";</script>
    {%- endunless -%}
  {%- endif -%}
{%- endunless -%}

{%- assign all_resources = section.blocks | where: 'type', 'resource' -%}
{%- assign use_default_resources = false -%}
{%- if all_resources.size == 0 -%}
  {%- assign use_default_resources = true -%}
{%- endif -%}
{%- capture mh_default_resources -%}
Catalogues & lookbooks||Season catalogues, range lookbooks and buyer guides||Marketing||Product sheets||All brands||book||mktg||/pages/catalogue-2026~~
Image downloads||Product photography, lifestyle and campaign imagery||Marketing||Imagery||All brands||image||mktg||/pages/image-downloads~~
Point of sale||In-store POS materials, posters and display assets||Marketing||Other||All brands||map-pin||mktg||/pages/point-of-sale~~
Website & social assets||Digital banners, social crops and web-ready imagery||Marketing||Social media||All brands||monitor||mktg||/pages/social-assets~~
Product descriptions||Approved copy, product specs and feature summaries||Marketing||Product sheets||All brands||file-text||mktg||/pages/product-descriptions~~
Videos||Product and brand video assets||Marketing||Imagery||All brands||file-text||mktg||~~
Policies||Environmental, ethical trading and supply chain policies||Sustainability||Policies||All brands||download||sustain||/pages/our-policies~~
Compliance sheets||Product compliance, testing and certification documents||Sustainability||Compliance||All brands||check-circle||sustain||/pages/compliance-sheets~~
Circular assets||Recycling, end-of-life and circular economy materials||Sustainability||Other||All brands||refresh||sustain||/pages/circular-assets-1~~
Eco-uniform assets||Eco range marketing materials and sustainability claims||Sustainability||Other||All brands||leaf||sustain||/pages/eco-uniform~~
Re:Uniform||Resale and re-use programme assets and partner materials||Sustainability||Other||All brands||repeat||sustain||/pages/re-uniform~~
Lesson plans||Educational resources and sustainability lesson content||Sustainability||Other||All brands||graduation||sustain||/pages/lesson-plans
{%- endcapture -%}
{%- assign default_resources = mh_default_resources | strip | split: '~~' -%}

<div class="mh-wrap" id="section-{{ section.id }}">
  <div class="mh-page-header">
    <div class="mh-page-header-inner">
      <h1 class="mh-page-title"><span class="mh-title-mark">{{ section.settings.page_title | escape }}</span></h1>
      <p class="mh-page-sub">{{ section.settings.page_subtitle | escape }}</p>
    </div>
  </div>

  <div class="mh-layout">
    <aside class="mh-sidebar" aria-label="Media hub filters">
      <div class="mh-filter-panel">
        <h2 class="mh-filter-heading">Find assets</h2>
        <div class="mh-sb-section">
          <div class="mh-sb-label">Resources</div>
          {%- assign shown_types = '' -%}
          {%- if use_default_resources -%}
            {%- for row in default_resources -%}
              {%- assign fields = row | split: '||' -%}
              {%- assign t = fields[3] -%}
              {%- unless shown_types contains t -%}
                {%- assign shown_types = shown_types | append: t | append: '~' -%}
                <button class="mh-cb-row" type="button" data-filter-type="type" data-filter-value="{{ t | handleize }}" aria-pressed="false">
                  <span class="mh-cb" data-cb></span>
                  <span class="mh-cb-label">{{ t }}</span>
                </button>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in all_resources -%}
              {%- assign t = block.settings.resource_type -%}
              {%- unless shown_types contains t -%}
                {%- assign shown_types = shown_types | append: t | append: '~' -%}
                <button class="mh-cb-row" type="button" data-filter-type="type" data-filter-value="{{ t | handleize }}" aria-pressed="false">
                  <span class="mh-cb" data-cb></span>
                  <span class="mh-cb-label">{{ t }}</span>
                </button>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="mh-sb-section">
          <div class="mh-sb-label">Brand</div>
          {%- assign shown_brands = '' -%}
          {%- if use_default_resources -%}
            {%- for row in default_resources -%}
              {%- assign fields = row | split: '||' -%}
              {%- assign b = fields[4] -%}
              {%- unless shown_brands contains b -%}
                {%- assign shown_brands = shown_brands | append: b | append: '~' -%}
                <button class="mh-cb-row" type="button" data-filter-type="brand" data-filter-value="{{ b | handleize }}" aria-pressed="false">
                  <span class="mh-cb" data-cb></span>
                  <span class="mh-cb-label">{{ b }}</span>
                </button>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in all_resources -%}
              {%- assign b = block.settings.brand -%}
              {%- unless shown_brands contains b -%}
                {%- assign shown_brands = shown_brands | append: b | append: '~' -%}
                <button class="mh-cb-row" type="button" data-filter-type="brand" data-filter-value="{{ b | handleize }}" aria-pressed="false">
                  <span class="mh-cb" data-cb></span>
                  <span class="mh-cb-label">{{ b }}</span>
                </button>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </aside>

    <main class="mh-main">
      <div class="mh-main-inner">
        <div class="mh-toolbar">
          <div class="mh-active-filter" data-active-filter style="display:none">
            <span class="mh-filter-icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            </span>
            <span class="mh-active-filter-text" data-filter-text>Filtered by: All</span>
            <button class="mh-active-filter-clear" type="button" data-clear-filters>Clear filters</button>
          </div>

          <div class="mh-search-bar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" data-search placeholder="Search resources..." aria-label="Search media hub resources" autocomplete="off">
          </div>
        </div>

        <div class="mh-empty" data-empty style="display:none"><p>No resources match your filters.</p></div>

        {%- assign shown_cats = '' -%}
        {%- if use_default_resources -%}
          {%- for row in default_resources -%}
            {%- assign fields = row | split: '||' -%}
            {%- assign c = fields[2] -%}
            {%- unless shown_cats contains c -%}
              {%- assign shown_cats = shown_cats | append: c | append: '~' -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
